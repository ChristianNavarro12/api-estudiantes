generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Student {
  id           Int     @id @default(autoincrement())
  nombre       String? @db.VarChar(255)
  apellido     String? @db.VarChar(255)
  edad         Int
  calificacion Decimal @db.Decimal(4, 2)

  @@map("students")
}
