{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,

    "types": ["node"],
    "sourceMap": true,

    "skipLibCheck": true
  },
  "exclude": ["node_modules", "prisma.config.ts", "prisma/", "tests/"]
}